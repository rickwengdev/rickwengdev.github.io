{
  "name": "rickweng-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-content.js",
    "build": "npm run check && node scripts/generate-sitemap.js && node scripts/generate-llms-txt.js && vite build && node scripts/prerender-seo.js && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.10",
    "vite": "^7.2.4"
  }
}
